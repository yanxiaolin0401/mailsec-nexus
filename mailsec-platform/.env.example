# Copy to .env; replace every CHANGE_ME value. Never commit real credentials.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CLICKHOUSE_PASSWORD=CHANGE_ME_SEARCH_PASSWORD
SMART_SEARCH_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN
# Set after creating a tenant in the administrator console.
SMART_SEARCH_TENANT_ID=
# Enable only after confirming this stack's search data belongs exclusively to that tenant.
SMART_SEARCH_DEDICATED=false
# Local HTTP only; set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
CSRF_SECRET=CHANGE_ME_RANDOM_CSRF_SECRET
PLATFORM_ORIGIN=http://localhost:8091
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

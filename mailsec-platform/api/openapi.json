          "password",
          "mode"
        ],
        "title": "Login"
      },
      "MailSearch": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "event",
              "legacy"
            ],
            "title": "Source",
            "default": "event"
          },
          "from_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Time"
          },
          "to_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Time"
          },
          "q": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Q"
          },
          "sender": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 320,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender"
          },
          "sender_domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender Domain"
          },
          "recipient": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 320,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "has_attachment": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Attachment"
          },
          "attachment_suffix": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment Suffix"
          },
          "sender_ip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 45
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender Ip"
          },
          "attachment_md5": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment Md5"
          },
          "risk_verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "pass",
                  "alert",
                  "reject"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Verdict"
          },
          "subject_or_attachment_contains": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Or Attachment Contains"
          },
          "attachment_name_contains": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment Name Contains"
          },
          "source_system_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Source System Id"
          },
          "risk_level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Level"
          },
          "limit": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 50
          },
          "offset": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },

# Generate unique local secrets. Never commit .env or place keys in prompts.
CLICKHOUSE_PASSWORD=
MAILSEC_API_TOKEN=
# Cloud: use .env.cloud with CLICKHOUSE_HOST/PORT=8443/USER/DB and TLS.
CLICKHOUSE_SECURE=false
MAILSEC_DATA_DIR=./var
# Base URL includes /v1. Supported providers: openai, anthropic.
MAILSEC_LLM_PROVIDER=
MAILSEC_LLM_BASE_URL=
MAILSEC_LLM_MODEL=
MAILSEC_LLM_API_KEY=
MAILSEC_LLM_TIMEOUT=15
MAILSEC_MAX_LLM_CALLS_PER_RUN=10
# Enable only for datasets approved for de-identified external transfer.
MAILSEC_LLM_EXTERNAL_AUTHORIZED=false
